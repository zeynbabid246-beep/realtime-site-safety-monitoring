# ============================================================
# Construction Safety AI - configuration template
# ============================================================
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Every key is OPTIONAL - the app runs with the defaults shown here.
# Secrets (Telegram token / chat id) must only ever live in `.env`.

# --- Storage -------------------------------------------------
# Single-file SQLite DB for events / alerts / counters.
SAFETY_DB_PATH=data/safety.db
# Root dir for evidence snapshots + clips (served read-only at /evidence).
SAFETY_EVIDENCE_DIR=data/evidence

# --- What gets recorded / alerted / captured -----------------
# Minimum risk level (inclusive) for each behaviour.
# One of: SAFE | LOW | MEDIUM | HIGH | CRITICAL
SAFETY_RECORD_MIN_RISK=LOW
SAFETY_ALERT_MIN_RISK=HIGH
SAFETY_EVIDENCE_MIN_RISK=HIGH

# --- Cooldowns (seconds) - bound DB growth + alert spam ------
SAFETY_EVENT_COOLDOWN_S=3.0
SAFETY_ALERT_COOLDOWN_S=30.0
SAFETY_EVIDENCE_COOLDOWN_S=10.0

# --- Evidence clip (rolling pre/post buffer, in frames) ------
SAFETY_CLIP_PRE_FRAMES=15
SAFETY_CLIP_POST_FRAMES=30
SAFETY_CLIP_FPS=10.0

# --- Pruning (keep newest N) ---------------------------------
SAFETY_MAX_EVIDENCE_FILES=500
SAFETY_MAX_EVENTS=20000

# --- Telegram alerts (optional) ------------------------------
# Leave blank to disable Telegram; the dashboard feed always works.
# Create a bot with @BotFather to get the token; get your chat id from
# @userinfobot or the getUpdates API. Set SAFETY_TELEGRAM_ENABLED=false
# to force-disable even when credentials are present.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SAFETY_TELEGRAM_ENABLED=true

# =============================================================
# Face recognition / worker verification (Siamese model)
# =============================================================
# Master switch. false = feature off, app behaves exactly as before.
FACE_RECOGNITION_ENABLED=true

# Trained Siamese model (from notebooks/Facial Verification with a
# Siamese Network.ipynb). Requires TensorFlow; if the file is missing
# the app starts WITHOUT face recognition and logs a warning.
FACE_MODEL_PATH=notebooks/siamesemodelv2.h5

# Worker identity data root. Layout:
#   <dir>/input_images/<worker_id>/*.jpg   reference face crops
#   <dir>/workers.json                     worker registry (auto-managed)
#   <dir>/embeddings/<worker_id>.npy       embedding cache (auto-managed)
#   <dir>/calibration.json                 calibrated thresholds (optional)
FACE_DATA_DIR=data/face_data

# Verification thresholds (see scripts/calibrate_threshold.py).
# detection: per-pair score above which a comparison counts as a match.
# verification: fraction of a worker's references that must match.
# Notebook used 0.9 which rejects most genuine pairs. The defaults are
# calibrated on the model's own training data; re-calibrate
# on YOUR workers with scripts/calibrate_threshold.py.
FACE_DETECTION_THRESHOLD=0.50
FACE_VERIFICATION_THRESHOLD=0.60
# Minimum relative margin over the runner-up worker (0 = disabled).
FACE_MIN_MARGIN=0.0

# Runtime cost / behaviour.
FACE_FRAME_STRIDE=1          # verify every Nth frame (websocket loop)
FACE_CACHE_TTL_S=2.0         # seconds a per-track identity stays cached
FACE_MIN_FACE_SIZE_PX=40     # skip smaller face crops
FACE_MAX_FACES_PER_FRAME=5
FACE_MIN_PERSON_CONFIDENCE=0.45

# Backend: "siamese" (real model, needs TF) or "stub" (tests/CI).
FACE_BACKEND=siamese
