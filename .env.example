# ============================================================
# Construction Safety AI - configuration template
# ============================================================
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Every key is OPTIONAL - the app runs with the defaults shown here.
# Secrets (Telegram token / chat id) must only ever live in `.env`.

# --- Storage -------------------------------------------------
# Single-file SQLite DB for events / alerts / counters.
SAFETY_DB_PATH=data/safety.db
# Root dir for evidence snapshots + clips (served read-only at /evidence).
SAFETY_EVIDENCE_DIR=data/evidence

# --- What gets recorded / alerted / captured -----------------
# Minimum risk level (inclusive) for each behaviour.
# One of: SAFE | LOW | MEDIUM | HIGH | CRITICAL
SAFETY_RECORD_MIN_RISK=LOW
SAFETY_ALERT_MIN_RISK=HIGH
SAFETY_EVIDENCE_MIN_RISK=HIGH

# --- Cooldowns (seconds) - bound DB growth + alert spam ------
SAFETY_EVENT_COOLDOWN_S=3.0
SAFETY_ALERT_COOLDOWN_S=30.0
SAFETY_EVIDENCE_COOLDOWN_S=10.0

# --- Evidence clip (rolling pre/post buffer, in frames) ------
SAFETY_CLIP_PRE_FRAMES=15
SAFETY_CLIP_POST_FRAMES=30
SAFETY_CLIP_FPS=10.0

# --- Pruning (keep newest N) ---------------------------------
SAFETY_MAX_EVIDENCE_FILES=500
SAFETY_MAX_EVENTS=20000

# --- Telegram alerts (optional) ------------------------------
# Leave blank to disable Telegram; the dashboard feed always works.
# Create a bot with @BotFather to get the token; get your chat id from
# @userinfobot or the getUpdates API. Set SAFETY_TELEGRAM_ENABLED=false
# to force-disable even when credentials are present.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SAFETY_TELEGRAM_ENABLED=true
